generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  balance   Float    @default(10000)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  positions   Position[]
  trades      Trade[]
  limitOrders LimitOrder[]
}

model Market {
  id          String   @id @default(cuid())
  title       String
  description String
  category    String
  resolution  String?  // Resolution criteria
  status      String   @default("active") // active, resolved_yes, resolved_no, cancelled
  yesPrice    Float    @default(0.5)  // 0-1 representing cents
  noPrice     Float    @default(0.5)
  volume      Float    @default(0)
  liquidity   Float    @default(100000)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  expiresAt   DateTime
  resolvedAt  DateTime?

  positions    Position[]
  trades       Trade[]
  priceHistory PriceHistory[]
  limitOrders  LimitOrder[]
}

model Position {
  id          String   @id @default(cuid())
  userId      String
  marketId    String
  side        String   // "yes" or "no"
  shares      Float
  avgPrice    Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id])
  market Market @relation(fields: [marketId], references: [id])

  @@unique([userId, marketId, side])
}

model Trade {
  id        String   @id @default(cuid())
  userId    String
  marketId  String
  side      String   // "yes" or "no"
  type      String   @default("market") // market, limit
  action    String   // "buy" or "sell"
  shares    Float
  price     Float
  total     Float
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  market Market @relation(fields: [marketId], references: [id])
}

model PriceHistory {
  id        String   @id @default(cuid())
  marketId  String
  yesPrice  Float
  noPrice   Float
  volume    Float    @default(0)
  timestamp DateTime @default(now())

  market Market @relation(fields: [marketId], references: [id])

  @@index([marketId, timestamp])
}

model AIStrategy {
  id         String   @id @default(cuid())
  name       String
  rule       String   // The strategy rule text
  confidence Float    @default(0.5)
  winRate    Float    @default(0)
  trades     Int      @default(0)
  profit     Float    @default(0)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model AITrade {
  id        String   @id @default(cuid())
  marketId  String
  side      String
  action    String
  shares    Float
  price     Float
  reasoning String
  strategy  String
  outcome   String?  // win, loss, pending
  pnl       Float?
  createdAt DateTime @default(now())
}

model PortfolioSnapshot {
  id             String   @id @default(cuid())
  userId         String
  portfolioValue Float
  cashBalance    Float
  positionValue  Float
  timestamp      DateTime @default(now())

  @@index([userId, timestamp])
}

model LimitOrder {
  id         String   @id @default(cuid())
  userId     String
  marketId   String
  side       String   // "yes" or "no"
  action     String   // "buy" or "sell"
  shares     Float
  limitPrice Float
  status     String   @default("open") // open, filled, cancelled
  createdAt  DateTime @default(now())
  filledAt   DateTime?

  user   User   @relation(fields: [userId], references: [id])
  market Market @relation(fields: [marketId], references: [id])
}
