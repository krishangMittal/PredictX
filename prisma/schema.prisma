generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id          String       @id @default(cuid())
  username    String       @unique
  balance     Float        @default(10000)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  limitOrders LimitOrder[]
  positions   Position[]
  trades      Trade[]
}

model Market {
  id           String         @id @default(cuid())
  title        String
  description  String
  category     String
  resolution   String?
  status       String         @default("active")
  yesPrice     Float          @default(0.5)
  noPrice      Float          @default(0.5)
  volume       Float          @default(0)
  liquidity    Float          @default(100000)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  expiresAt    DateTime
  resolvedAt   DateTime?
  limitOrders  LimitOrder[]
  positions    Position[]
  priceHistory PriceHistory[]
  trades       Trade[]
}

model Position {
  id        String   @id @default(cuid())
  userId    String
  marketId  String
  side      String
  shares    Float
  avgPrice  Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  market    Market   @relation(fields: [marketId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, marketId, side])
}

model Trade {
  id        String   @id @default(cuid())
  userId    String
  marketId  String
  side      String
  type      String   @default("market")
  action    String
  shares    Float
  price     Float
  total     Float
  createdAt DateTime @default(now())
  market    Market   @relation(fields: [marketId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
}

model PriceHistory {
  id        String   @id @default(cuid())
  marketId  String
  yesPrice  Float
  noPrice   Float
  volume    Float    @default(0)
  timestamp DateTime @default(now())
  market    Market   @relation(fields: [marketId], references: [id])

  @@index([marketId, timestamp])
}

model AIStrategy {
  id         String   @id @default(cuid())
  name       String
  rule       String
  confidence Float    @default(0.5)
  winRate    Float    @default(0)
  trades     Int      @default(0)
  profit     Float    @default(0)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model AITrade {
  id        String   @id @default(cuid())
  marketId  String
  side      String
  action    String
  shares    Float
  price     Float
  reasoning String
  strategy  String
  outcome   String?
  pnl       Float?
  createdAt DateTime @default(now())
}

model PortfolioSnapshot {
  id             String   @id @default(cuid())
  userId         String
  portfolioValue Float
  cashBalance    Float
  positionValue  Float
  timestamp      DateTime @default(now())

  @@index([userId, timestamp])
}

model LimitOrder {
  id         String    @id @default(cuid())
  userId     String
  marketId   String
  side       String
  action     String
  shares     Float
  limitPrice Float
  status     String    @default("open")
  createdAt  DateTime  @default(now())
  filledAt   DateTime?
  market     Market    @relation(fields: [marketId], references: [id])
  user       User      @relation(fields: [userId], references: [id])
}
